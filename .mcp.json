{
  "mcpServers": {
    "remote-dev": {
      "command": ".venv/bin/python",
      "args": ["-m", "remote_dev.mcp.server"],
      "env": {
        "REMOTE_DEV_DEFAULT_USER": "root",
        "REMOTE_DEV_STATE_DIR": ".vaws-local/remote-dev-state",
        "REMOTE_DEV_SSH_MUX_DIR": "~/.ssh/vaws-mux"
      },
      "timeout": 600000
    },
    "vaws-task": {
      "command": ".venv/bin/python",
      "args": ["-m", "vaws_coordinator", "task-server"],
      "env": {
        "VAWS_AGENT_SESSIONS_DIR": ".vaws-local/agent-sessions"
      },
      "timeout": 600000
    },
    "vaws-knowledge": {
      "command": ".venv/bin/python",
      "args": ["-m", "vaws_knowledge.server.mcp_server"],
      "env": {
        "VAWS_KNOWLEDGE_PROJECT_ROOTS": ".agents/knowledge",
        "VAWS_KNOWLEDGE_CANDIDATE_ROOT": ".vaws-local/knowledge/candidate",
        "VAWS_KNOWLEDGE_ORIGIN_REPO": "vllm-ascend-workspace/vllm-ascend-workspace"
      },
      "timeout": 600000
    }
  }
}
