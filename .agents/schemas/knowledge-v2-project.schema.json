{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-ascend-workspace.local/schemas/knowledge-v2-project.schema.json",
  "title": "vLLM Ascend Workspace Project-Layer Knowledge Document v2",
  "$comment": "Project-layer note only. The executable contract is the installed vaws-knowledge schema/validate/canonical/export/redact APIs. Unresolved coordinates are unbounded ranges; sourced references omit runtime scope. This file is not a second body/schema engine.",

  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "layer", "updated_at", "entries"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Document family; must match the <kind>.v2.yaml file name."
    },
    "layer": {
      "enum": ["project", "verified", "unverified"],
      "description": "project for documents in .agents/knowledge/; verified/unverified only for a read-only cache of the shared corpus."
    },
    "updated_at": { "$ref": "#/$defs/date" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },

  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },

    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },

    "unresolved": {
      "$comment": "Project-layer only. Not upstream-valid, on purpose: an entry carrying one cannot be exported and cannot reach status verified. It exists so that a migrated or freshly captured entry can say 'nobody established this dimension' instead of carrying an invented range that would read as established fact.",
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved", "needs"],
      "properties": {
        "unresolved": { "const": true },
        "needs": {
          "type": "string",
          "minLength": 12,
          "description": "What a human has to supply, concretely enough to act on."
        },
        "note": { "type": "string" }
      }
    },

    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any", "basis"],
          "properties": {
            "any": { "const": true },
            "basis": { "type": "string", "minLength": 12 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["range"],
          "properties": {
            "range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": ["string", "null"] },
                "max": { "type": ["string", "null"] }
              }
            }
          }
        },
        { "$ref": "#/$defs/unresolved" }
      ]
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc",
        "cann",
        "driver",
        "python_abi",
        "torch",
        "torch_npu",
        "vllm",
        "vllm_ascend",
        "model",
        "topology",
        "execution_mode",
        "component"
      ],
      "properties": {
        "soc": { "$ref": "#/$defs/constraint" },
        "cann": { "$ref": "#/$defs/constraint" },
        "driver": { "$ref": "#/$defs/constraint" },
        "python_abi": { "$ref": "#/$defs/constraint" },
        "torch": { "$ref": "#/$defs/constraint" },
        "torch_npu": { "$ref": "#/$defs/constraint" },
        "vllm": { "$ref": "#/$defs/constraint" },
        "vllm_ascend": { "$ref": "#/$defs/constraint" },
        "model": { "$ref": "#/$defs/constraint" },
        "topology": { "$ref": "#/$defs/constraint" },
        "execution_mode": { "$ref": "#/$defs/constraint" },
        "component": { "$ref": "#/$defs/constraint" }
      }
    },

    "concrete_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soc", "cann", "driver", "torch", "torch_npu", "vllm", "vllm_ascend"],
      "properties": {
        "soc": { "type": "string", "minLength": 1 },
        "cann": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "python_abi": { "type": "string" },
        "torch": { "type": "string", "minLength": 1 },
        "torch_npu": { "type": "string", "minLength": 1 },
        "vllm": { "type": "string", "minLength": 1 },
        "vllm_ascend": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "topology": { "type": "string" },
        "execution_mode": { "type": "string" }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": { "enum": ["run_manifest", "pull_request", "issue", "commit", "ci_run"] },
        "ref": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributor", "origin_repo", "submitted_at", "redaction_profile"],
      "properties": {
        "contributor": { "type": "string", "minLength": 1 },
        "origin_repo": { "type": "string", "minLength": 1 },
        "submitted_at": { "$ref": "#/$defs/date" },
        "redaction_profile": { "type": "string", "pattern": "^r[0-9]+$" }
      }
    },

    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "verified_by", "verified_against", "last_verified_at"],
      "properties": {
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "verified_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "verified_against": { "$ref": "#/$defs/concrete_environment" },
        "last_verified_at": { "$ref": "#/$defs/date" }
      }
    },

    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_seen", "updated_at"],
      "properties": {
        "first_seen": { "$ref": "#/$defs/date" },
        "updated_at": { "$ref": "#/$defs/date" },
        "supersedes": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "superseded_by": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "resolved_by": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "ref"],
              "properties": {
                "type": { "enum": ["pull_request", "commit", "release"] },
                "ref": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },

    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with", "undeclared_dimensions", "recorded_at"],
      "properties": {
        "with": { "$ref": "#/$defs/uuid" },
        "undeclared_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "soc", "cann", "driver", "python_abi", "torch", "torch_npu",
              "vllm", "vllm_ascend", "model", "topology", "execution_mode", "component"
            ]
          }
        },
        "recorded_at": { "$ref": "#/$defs/date" },
        "note": { "type": "string" }
      }
    },

    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "symptom", "root_cause", "resolution"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "symptom": { "type": "string", "minLength": 1 },
        "root_cause": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "avoidance": { "type": "string" },
        "fingerprints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },

    "measurement_quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "basis", "value", "unit"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,63}$" },
        "basis": { "enum": ["declared", "theoretical", "measured", "sustained"] },
        "value": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
        "unit": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "qualifier": { "type": "string", "minLength": 1 }
      }
    },

    "measurement_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "family": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "core_version": { "type": "string", "minLength": 1 },
        "compiler_target": { "type": "string", "minLength": 1 }
      }
    },

    "measurement_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,63}$" },
        "value": { "type": "string", "minLength": 1 }
      }
    },

    "measurement_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["vendor_file", "run_manifest", "pull_request", "issue", "commit", "ci_run"] },
        "ref": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
        "note": { "type": "string" }
      }
    },

    "measurement": {
      "$comment": "Second body variant. A number has no symptom or resolution. Exactly one of rule / measurement per entry; content_hash is scope + that body, keyed by the body's own name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "subject", "method", "quantities"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/measurement_subject" },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "description", "source"],
          "properties": {
            "type": { "enum": ["vendor_platform_config", "microbenchmark"] },
            "description": { "type": "string", "minLength": 12 },
            "parameters": { "type": "array", "items": { "$ref": "#/$defs/measurement_parameter" } },
            "source": { "$ref": "#/$defs/measurement_source" }
          }
        },
        "quantities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measurement_quantity" }
        },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },

    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "slug",
        "content_hash",
        "status",
        "confidence",
        "scope",
        "provenance",
        "lifecycle"
      ],
      "properties": {
        "uuid": { "$ref": "#/$defs/uuid" },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "description": "Human handle. Migration puts the former v1 entry id here, which is also how re-migration stays idempotent."
        },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "enum": ["verified", "unverified", "stale", "deprecated", "resolved"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "scope": { "$ref": "#/$defs/scope" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "verification": { "$ref": "#/$defs/verification" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "rule": { "$ref": "#/$defs/rule" },
        "measurement": { "$ref": "#/$defs/measurement" }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["rule"] },
            { "required": ["measurement"] }
          ]
        },
        {
          "if": {
            "properties": { "status": { "enum": ["verified", "stale"] } },
            "required": ["status"]
          },
          "then": {
            "required": ["verification"],
            "properties": {
              "verification": {
                "properties": {
                  "evidence": { "minItems": 1 },
                  "verified_by": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "resolved" } },
            "required": ["status"]
          },
          "then": {
            "required": ["lifecycle"],
            "properties": {
              "lifecycle": {
                "properties": { "resolved_by": { "type": "object" } },
                "required": ["resolved_by"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "confidence": { "const": "high" } },
            "required": ["confidence"]
          },
          "then": {
            "properties": { "status": { "enum": ["verified", "stale", "resolved"] } }
          }
        },
        {
          "$comment": "An unresolved dimension anywhere in the coordinate keeps the entry out of any status that asserts the claim was established. Expressed here as: if every dimension is a bounded/any constraint (no unresolved marker), no extra restriction applies; otherwise status must be unverified or deprecated.",
          "if": {
            "properties": {
              "scope": {
                "anyOf": [
                  { "properties": { "soc": { "$ref": "#/$defs/unresolved" } }, "required": ["soc"] },
                  { "properties": { "cann": { "$ref": "#/$defs/unresolved" } }, "required": ["cann"] },
                  { "properties": { "driver": { "$ref": "#/$defs/unresolved" } }, "required": ["driver"] },
                  { "properties": { "python_abi": { "$ref": "#/$defs/unresolved" } }, "required": ["python_abi"] },
                  { "properties": { "torch": { "$ref": "#/$defs/unresolved" } }, "required": ["torch"] },
                  { "properties": { "torch_npu": { "$ref": "#/$defs/unresolved" } }, "required": ["torch_npu"] },
                  { "properties": { "vllm": { "$ref": "#/$defs/unresolved" } }, "required": ["vllm"] },
                  { "properties": { "vllm_ascend": { "$ref": "#/$defs/unresolved" } }, "required": ["vllm_ascend"] },
                  { "properties": { "model": { "$ref": "#/$defs/unresolved" } }, "required": ["model"] },
                  { "properties": { "topology": { "$ref": "#/$defs/unresolved" } }, "required": ["topology"] },
                  { "properties": { "execution_mode": { "$ref": "#/$defs/unresolved" } }, "required": ["execution_mode"] },
                  { "properties": { "component": { "$ref": "#/$defs/unresolved" } }, "required": ["component"] }
                ]
              }
            },
            "required": ["scope"]
          },
          "then": {
            "properties": { "status": { "enum": ["unverified", "deprecated"] } }
          }
        }
      ]
    }
  }
}
